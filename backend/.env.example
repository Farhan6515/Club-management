PORT=5100
MONGO_URI=mongodb://localhost:27017/club-management
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
NODE_ENV=development

# Valid Department IDs for admin access (comma-separated)
# Anyone using these IDs during club creation becomes that club's admin
VALID_DEPT_IDS=CSE-2024-ADMIN,ECE-2024-ADMIN,MECH-2024-ADMIN,CIVIL-2024-ADMIN,IT-2024-ADMIN,EEE-2024-ADMIN
