PORT=5100
MONGO_URI=mongodb://localhost:27017/club-management
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
NODE_ENV=development

# Valid Department IDs for admin access (comma-separated)
VALID_DEPT_IDS=CSE-2024-ADMIN,ECE-2024-ADMIN,MECH-2024-ADMIN,CIVIL-2024-ADMIN,IT-2024-ADMIN,EEE-2024-ADMIN

# Cloudinary (https://cloudinary.com — free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
